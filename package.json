{
  "name": "ifto-monitor",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:host": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "lint": "eslint src tests web supabase/functions/_shared/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-apk.mjs",
    "predev": "node scripts/dev-deps.mjs",
    "predev:host": "node scripts/dev-deps.mjs",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts --configLoader runner",
    "dev:web": "vite --config vite.config.web.ts --configLoader runner"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/background-geolocation": "^8.6.4",
    "@supabase/supabase-js": "^2.118.0",
    "idb": "7.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.60.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.8",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/estree": "1.0.9",
    "vite": "7.3.8"
  }
}
